#!/bin/bash
# ExecStart for jarvis-tools.service: the specialist MCP server, as UID 10001, on the jarvis bridge only (no
# published port). It holds the security-tool credentials; the Hermes container never sees them. org.env carries the
# organisation and provider settings (no secrets) shared with Hermes.
set -euo pipefail

exec docker run --rm --name jarvis-tools \
  --init \
  --user 10001:10001 \
  --read-only \
  --tmpfs /tmp:rw,noexec,nosuid,nodev,size=64m,uid=10001,gid=10001,mode=0700 \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --memory 1g --pids-limit 256 \
  --network jarvis \
  --log-driver journald --log-opt tag=jarvis-tools \
  --env-file /opt/jarvis/hermes/managed/org.env \
  --env-file /run/jarvis/tools.env \
  jarvis-tools:local
