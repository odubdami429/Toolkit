[Unit]
Description=Jarvis: jarvis-tools specialist MCP server
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
# Optional host settings for jarvis-secrets (JARVIS_SECRET_ID, AWS_REGION); the defaults apply without it.
EnvironmentFile=-/opt/jarvis/hermes/managed/host.env
ExecStartPre=-/usr/bin/docker rm -f jarvis-tools
ExecStartPre=/opt/jarvis/hermes/bin/jarvis-secrets
ExecStart=/opt/jarvis/hermes/bin/jarvis-tools-run
ExecStop=/usr/bin/docker stop --time 30 jarvis-tools
ExecStopPost=/usr/bin/rm -f /run/jarvis/tools.env
TimeoutStopSec=45
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
