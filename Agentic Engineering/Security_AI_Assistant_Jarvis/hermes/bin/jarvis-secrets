#!/bin/bash
# Root oneshot (ExecStartPre of both jarvis-tools and jarvis-hermes): Secrets Manager -> per-container env files on
# tmpfs, read by dockerd as --env-file. Each container gets only what it needs:
#   /run/jarvis/hermes.env  Slack tokens, Anthropic key, jarvis-tools bearer token + guard HMAC key
#   /run/jarvis/tools.env   Anthropic key, security-tool credentials (whichever are set), the same bearer token + HMAC key
# The bearer token and HMAC key are random per boot (/run is tmpfs) and reused across unit restarts, so either
# container can restart without breaking the other.
# Never echoes a value: the secret goes from the CLI to python on a pipe, not through argv or the journal.
#
# The secret is one JSON object (Secrets Manager "Key/value"). Required: slack_bot_token, slack_app_token,
# anthropic_api_key. Every security-tool key is optional and generic per domain (<prefix>_api_token, _username,
# _client_id, _client_secret, _key_id, _private_key; see below); a domain whose credentials are missing is simply
# not enabled.
# Which secret and region: JARVIS_SECRET_ID (default jarvis/prod/hermes) and AWS_REGION (default us-east-1), from the
# environment or the optional /opt/jarvis/hermes/managed/host.env that both units load.
set -euo pipefail
umask 077

SECRET_ID=${JARVIS_SECRET_ID:-jarvis/prod/hermes}
REGION=${AWS_REGION:-us-east-1}

install -d -m 0700 -o root -g root /run/jarvis
# Per-start nonce for jarvis-guard-canary (not a secret): the guard echoes it once it has registered.
python3 -I -c 'import secrets; print(secrets.token_hex(16))' > /run/jarvis/guard-nonce

aws secretsmanager get-secret-value --region "$REGION" --secret-id "$SECRET_ID" \
  --query SecretString --output text \
| python3 -I -c '
import base64, json, os, secrets, sys

try:
    s = json.load(sys.stdin)
except ValueError:
    sys.exit("jarvis-secrets: secret is empty or not a JSON object (set it on the Key/value tab)")

def get(key, prefix, required=True):
    v = str(s.get(key, "")).strip()
    if not v:
        if required:
            problems.append(f"{key} missing")
        return ""
    if prefix and not v.startswith(prefix):
        problems.append(f"{key} does not start with {prefix}")
    elif any(c in v for c in "\r\n"):
        problems.append(f"{key} contains a newline")
    return v

problems = []
slack_bot = get("slack_bot_token", "xoxb-")
slack_app = get("slack_app_token", "xapp-")
anthropic = get("anthropic_api_key", "sk-ant-")
# Security-tool credentials: the same generic, optional keys for every domain. Which adapter each domain uses is
# <PREFIX>_PROVIDER in org.env; these are only its credentials, and each adapter documents which of them it reads.
# A domain whose adapter finds no usable credentials is simply not enabled.
#   <prefix>_api_token      static API token / key           -> <PREFIX>_API_TOKEN
#   <prefix>_username       account the token belongs to     -> <PREFIX>_USERNAME
#   <prefix>_client_id      OAuth client id                  -> <PREFIX>_CLIENT_ID
#   <prefix>_client_secret  OAuth client secret              -> <PREFIX>_CLIENT_SECRET
#   <prefix>_key_id         id of the signing key            -> <PREFIX>_KEY_ID
#   <prefix>_private_key    PEM signing key (JWT assertions) -> <PREFIX>_PRIVATE_KEY_B64
# The PEM has newlines, which an env file cannot carry, so it travels base64-encoded.
DOMAINS = ("edr", "idp", "suite", "email_security", "brand_protection", "insider_risk", "ticketing",
           "enterprise_search")
FIELDS = ("api_token", "username", "client_id", "client_secret", "key_id")
tool_pairs, domain_status = [], []
for d in DOMAINS:
    vals = {f: get(f"{d}_{f}", "", required=False) for f in FIELDS}
    pem = str(s.get(f"{d}_private_key", "")).strip()
    if pem and not ("-----BEGIN" in pem and "PRIVATE KEY-----" in pem and "-----END" in pem):
        problems.append(f"{d}_private_key is not a PEM private key")
    if vals["client_id"] and not (vals["client_secret"] or pem):
        problems.append(f"{d}_client_id needs {d}_client_secret or {d}_private_key")
    for f in FIELDS:
        tool_pairs.append((d.upper() + "_" + f.upper(), vals[f]))
    tool_pairs.append((d.upper() + "_PRIVATE_KEY_B64",
                       base64.b64encode((pem + "\n").encode()).decode() if pem else ""))
    have = [f for f in FIELDS if vals[f]] + (["private_key"] if pem else [])
    domain_status.append(d + ": " + ("+".join(have) if have else "-"))
# Kill switch for every security-tool write tool: writes are on unless jarvis_writes_enabled is "false" (then restart jarvis-tools).
writes_enabled = "false" if str(s.get("jarvis_writes_enabled", "")).strip().lower() == "false" else "true"
# Its own switch for automatic actions on alert-bot posts: on unless jarvis_auto_close_enabled is "false".
auto_close_enabled = "false" if str(s.get("jarvis_auto_close_enabled", "")).strip().lower() == "false" else "true"
# Off switch for the Jarvis Slack actions (create_slack_channel, join_slack_channel), read by the guard in Hermes.
slack_writes_enabled = "false" if str(s.get("jarvis_slack_writes_enabled", "")).strip().lower() == "false" else "true"
if problems:
    sys.exit("jarvis-secrets: " + "; ".join(problems))

keys_path = "/run/jarvis/session-keys.json"
try:
    keys = json.load(open(keys_path))
except (OSError, ValueError):
    keys = {"tools_token": secrets.token_urlsafe(32), "guard_hmac_key": secrets.token_hex(32)}
    fd = os.open(keys_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o400)
    with os.fdopen(fd, "w") as f:
        json.dump(keys, f)

def write(path, pairs):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o400)
    with os.fdopen(fd, "w") as f:
        f.write("".join(f"{k}={v}\n" for k, v in pairs if v))
    os.replace(tmp, path)

shared = [("JARVIS_TOOLS_TOKEN", keys["tools_token"]), ("JARVIS_GUARD_HMAC_KEY", keys["guard_hmac_key"])]
write("/run/jarvis/hermes.env",
      [("SLACK_BOT_TOKEN", slack_bot), ("SLACK_APP_TOKEN", slack_app), ("ANTHROPIC_API_KEY", anthropic),
       ("JARVIS_SLACK_WRITES_ENABLED", slack_writes_enabled)] + shared)
write("/run/jarvis/tools.env",
      [("ANTHROPIC_API_KEY", anthropic)] + tool_pairs +
      [("JARVIS_WRITES_ENABLED", writes_enabled),
       ("JARVIS_AUTO_CLOSE_ENABLED", auto_close_enabled)] + shared)
# Which credential fields each domain has (names only, never values).
print("jarvis-secrets: wrote hermes.env and tools.env (%s; writes: %s, auto_close: %s, slack_writes: %s)"
      % (", ".join(domain_status), writes_enabled, auto_close_enabled, slack_writes_enabled))
'
