# Organisation and security-tool provider settings. Copy to org.env and fill in; org.env is gitignored.
#
# install.sh installs it at /opt/jarvis/hermes/managed/org.env (root-owned, read-only), and systemd passes it with
# --env-file to BOTH containers (Hermes and jarvis-tools). install.sh also uses it to render the {{...}} placeholders
# in SOUL.md. No secrets here: credentials go in the Secrets Manager secret (see hermes/bin/jarvis-secrets);
# jarvis-preflight refuses credential-looking keys. Values are literal (docker --env-file): no quotes, no $expansion.
# After a change, rerun install.sh (it re-renders SOUL.md) and restart both units.

# --- Organisation --------------------------------------------------------------------------------------------------
# Display name used in prompts and messages.
ORG_NAME=Example Corp
# Work email domains, primary first. Requester emails must be on the primary domain (enterprise search acts as the
# requester).
ORG_EMAIL_DOMAINS=example.com,example.org
# Other domains the organisation owns (web hosts, link shorteners). Never treated as external; never sent to a
# third-party scanner.
ORG_EXTRA_DOMAINS=example.net
# Name of the team that owns Jarvis, without the word "team": used as "the Security team", "Escalate to the Security
# team".
ORG_SECURITY_TEAM=Security

# --- Who may act ---------------------------------------------------------------------------------------------------
# Slack member IDs allowed to have Jarvis take security-tool actions and create channels. Each must also be in
# SLACK_ALLOWED_USERS (managed .env); jarvis-preflight checks this. Leave empty for a read-only deployment.
JARVIS_WRITERS=U00000000A1,U00000000A2
# Slack bot user ID(s) of your alert pipeline, allowed to start triage turns by @-mentioning Jarvis in
# JARVIS_BOT_CHANNELS (managed .env). Leave empty to disable bot triggers (then set SLACK_ALLOW_BOTS=none).
JARVIS_TRIGGER_BOTS=U00000000B1
# How briefs and notes name the alert pipeline.
JARVIS_ALERT_BOT_NAME=alert bot
# Slack user group (S...) whose members create_slack_channel invites, and a fallback member list used only when the
# group can't be read. Required: SOUL.md tags the group (<!subteam^...>) on alerts that need a person, so install.sh
# won't render without it, and create_slack_channel refuses if it is unset.
JARVIS_SECURITY_GROUP=S00000000G1
JARVIS_SECURITY_GROUP_FALLBACK=U00000000A1,U00000000A2

# --- Providers (jarvis-tools) -------------------------------------------------------------------------------------
# One adapter per security domain. <PREFIX>_PROVIDER is an adapter key registered in tools/app/providers/__init__.py:
#   example  the shipped skeleton: validates input, then answers every tool with status "not_implemented"
#   <yours>  the key you registered for your own adapter (see "Implementing an adapter" in the README)
# Empty (or "none") disables the domain; an unknown key stops jarvis-tools at startup. A domain is enabled only when
# its provider, its base URL and its credentials (generic <prefix>_* keys in the secret, see hermes/bin/jarvis-secrets)
# are all set.
#   <PREFIX>_BASE_URL     the product's API origin (bare https origin, fixed at startup, never taken from model input)
#   <PREFIX>_CONSOLE_URL  the product's web console origin. Used to recognise alert links in alert-bot posts for
#                         automatic actions (domains that have them); leave empty to recognise none.
# Adapters may read extra non-secret <PREFIX>_* settings (e.g. a tenant or account id); each adapter documents its own
# in its module docstring. Never put a credential here: jarvis-preflight refuses credential-looking keys.

# EDR (endpoint detection and response).
EDR_PROVIDER=
EDR_BASE_URL=
EDR_CONSOLE_URL=

# Identity provider.
IDP_PROVIDER=
IDP_BASE_URL=
IDP_CONSOLE_URL=

# Productivity suite (email/docs/calendar admin and activity).
SUITE_PROVIDER=
SUITE_BASE_URL=
SUITE_CONSOLE_URL=

# Email security.
EMAIL_SECURITY_PROVIDER=
EMAIL_SECURITY_BASE_URL=
EMAIL_SECURITY_CONSOLE_URL=

# Brand protection.
BRAND_PROTECTION_PROVIDER=
BRAND_PROTECTION_BASE_URL=
BRAND_PROTECTION_CONSOLE_URL=

# Insider risk / DLP.
INSIDER_RISK_PROVIDER=
INSIDER_RISK_BASE_URL=
INSIDER_RISK_CONSOLE_URL=

# Ticketing and wiki.
TICKETING_PROVIDER=
TICKETING_BASE_URL=
TICKETING_CONSOLE_URL=

# Enterprise search.
ENTERPRISE_SEARCH_PROVIDER=
ENTERPRISE_SEARCH_BASE_URL=
ENTERPRISE_SEARCH_CONSOLE_URL=

# --- Policy --------------------------------------------------------------------------------------------------------
# Identity provider groups that grant access to your sanctioned generative-AI tools (insider-risk AI-entitlement check).
# Exact, case-sensitive.
SANCTIONED_AI_GROUPS=ai-assistant-users
# The sanctioned AI tools themselves, as "Name (domain, domain)" entries; the insider-risk prompt uses this to know
# which AI destinations the entitlement check applies to.
SANCTIONED_AI_TOOLS=Example AI Assistant (assistant.example.net)
