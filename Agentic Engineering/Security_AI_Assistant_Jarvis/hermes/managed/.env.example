# Hermes managed env. Copy to .env and fill in; .env is gitignored. install.sh installs it root-owned (0644) and it
# is mounted read-only at /etc/hermes/.env, which Hermes applies last, with override. Only the Hermes container reads
# it. Settings shared with jarvis-tools (who may act, the alert bot, security-tool providers) are in org.env.
# Secrets are NOT here: jarvis-secrets writes them to /run/jarvis/hermes.env (tmpfs) at each start.

# Slack member IDs (comma-separated) allowed to talk to Jarvis. Not synced from any Slack group: edit here when your
# team changes. Being here allows reads only; security-tool actions and channel creation also need JARVIS_WRITERS (org.env).
# If you use alert-bot triggers (SLACK_ALLOW_BOTS=mentions below), each bot in JARVIS_TRIGGER_BOTS must be listed
# here too (the last ID below); the guard never treats it as a person.
SLACK_ALLOWED_USERS=U00000000A1,U00000000A2,U00000000A3,U00000000B1
# Your Slack workspace ID (auth.test team_id). jarvis_guard denies every tool call from any other workspace, so a
# token mix-up fails closed; jarvis-preflight refuses to start without it.
JARVIS_SLACK_TEAM_ID=T00000000
GATEWAY_ALLOWED_USERS=
SLACK_ALLOW_ALL_USERS=false
GATEWAY_ALLOW_ALL_USERS=false
# Alert triage: a bot in JARVIS_TRIGGER_BOTS (org.env) may start a turn by @-mentioning Jarvis, only in
# JARVIS_BOT_CHANNELS (channel IDs, never DMs), at most JARVIS_BOT_TRIGGERS_PER_HOUR times an hour. With "mentions"
# Hermes lets any bot skip SLACK_ALLOWED_USERS, so jarvis_guard drops every other bot and channel before Hermes's auth
# runs and re-checks the requester on every tool call. Set SLACK_ALLOW_BOTS=none (and leave JARVIS_TRIGGER_BOTS empty)
# to turn bot triggers off.
SLACK_ALLOW_BOTS=mentions
JARVIS_BOT_CHANNELS=C00000000C1
JARVIS_BOT_TRIGGERS_PER_HOUR=20
# Slack write tools: create_slack_channel is limited to JARVIS_WRITERS (org.env); join_slack_channel to any
# allowlisted person. Both post an audit line in JARVIS_AUDIT_CHANNEL (usually your alert channel). Off switch: secret
# key jarvis_slack_writes_enabled=false, then restart jarvis-hermes.
JARVIS_AUDIT_CHANNEL=C00000000C1
SLACK_REQUIRE_MENTION=true
SLACK_STRICT_MENTION=true
SLACK_THREAD_REQUIRE_MENTION=true
HERMES_SAFE_MODE=0
# A home channel stops the first-DM "/hermes sethome" prompt. C0000000000 doesn't exist, and nothing (cron,
# cross-platform) is meant to deliver anywhere.
SLACK_HOME_CHANNEL=C0000000000
HERMES_MEDIA_DELIVERY_STRICT=1
HERMES_MEDIA_TRUST_RECENT_FILES=0
HERMES_GATEWAY_BUSY_INPUT_MODE=queue
HERMES_SKIP_CONFIG_MIGRATION=1
